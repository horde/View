{
    "name": "horde/view",
    "description": "View pattern library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_View",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Mike Naberezny",
            "email": "mike@maintainable.com",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "time": "2025-05-06",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/exception": "^3",
        "horde/support": "^3",
        "horde/util": "^3"
    },
    "require-dev": {
        "horde/test": "^3",
        "horde/log": "^3"
    },
    "suggest": {
        "horde/controller": "^3",
        "horde/routes": "^3",
        "ext-json": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_View": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\View\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": []
    }
}